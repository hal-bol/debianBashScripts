#!/bin/bash
getUserInputFunc()
	{
		echo -e "\033[93m\e[4m\n---<USER INFO>---\n\e[24m"
		UIDmin=$(grep "^UID_MIN" /etc/login.defs)
		UIDmax=$(grep "^UID_MAX" /etc/login.defs)
		echo -e "\033[36mSrc:/etc/login.defs\n   ->\033[39m Defined ID Range: \n\033[35m$UIDmin\033[39m | \033[35m$UIDmax\033[39m"
			#Finds low and high UsrID, then print all UID's low += max, excludes root
		echo -e "\n\033[36mSrc:/etc/passwd\n   \033[36m->\033[39m All non-root users:\n\nuserName :x: UID# : [Alias] : /homeDir/ : shell\e[35m"
		awk -F':' -v "min=${UIDmin#UID_MIN}" -v "max=${UIDmax##UID_MAX}" '{ if ( $3 >= min && $3 <= max ) print $0}' /etc/passwd
		#echo -e "\e[0m\033[36m\nDefault Permitted Groups:
		echo -e "\n\e[0m\033[36m   ->\033[0m Default Permitted Groups:\n\ngroupID : x : GID# : [Alias]	\033[35m"
			getent group root
			getent group sudo
	}
getCurrentSecurityConfFunc()
 	{
		logGoodLogins=$(grep "^LOG_OK_LOGINS" /etc/login.defs)
		passwordMaxDays=$(grep "^PASS_MAX_DAYS" /etc/login.defs)
		loginRetries=$(grep "^LOGIN_RETRIES" /etc/login.defs)
		loginTimeout=$(grep "^LOGIN_TIMEOUT" /etc/login.defs)
		passwordEncryptionMethod=$(grep "^ENCRYPT_METHOD" /etc/login.defs)
		echo -e "\n\033[36mSrc:/etc/passwd\n   ->\033[39m Current Login Config:\n"
		echo -e "\033[35m$logGoodLogins\n$passwordMaxDays\n$loginRetries\n$loginTimeout\n$passwordEncryptionMethod\e[0m"
	}
