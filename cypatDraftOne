displayUsrOption(){
	echo -e "\n\033[36m	OPTIONS:\n\033[93m\n <USER INFO> - (1)   <SECURITY CONFIG> - (2)\033[39m\n"
}
declare -i timeout=0
while [ $timeout -eq 0 ]; do
	displayUsrOption
	input=0
	read -sn1 input
		if [ $input -eq 1 ]; then
			getUserInputFunc			
			echo -e "\n\033[94m\e[1m0 to return\e[0m"
			while [ $input -ne 0 ]; do 
				read -sn1 input
			done
		elif [ $input -eq 2 ]; then
			getCurrentSecurityConfFunc
			echo -e "\n\033[94m\e[1m0 to return\e[0m"
