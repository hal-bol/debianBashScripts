MAIL_DIR        /var/mail
LOG_UNKFAIL_ENAB	no
#KEEP NO TO PREVENT INJECTIONS ^
LOG_OK_LOGINS		yes

#TTYTYPE_FILE	/etc/ttytype
HUSHLOGIN_FILE	.hushlogin
#HUSHLOGIN_FILE	/etc/hushlogins
ENV_SUPATH	PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV_PATH	PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games
#TTYGROUP	tty
TTYPERM		0600
#
#	ERASECHAR	Terminal ERASE character ('\010' = backspace).
#	KILLCHAR	Terminal KILL character ('\025' = CTRL/U).
#
# The ERASECHAR and KILLCHAR are used only on System V machines.
#
ERASECHAR	0177
KILLCHAR	025
HOME_MODE	0700
#newhome dir assignment^
#
#	PASS_MAX_DAYS	Maximum number of days a password may be used.
#	PASS_MIN_DAYS	Minimum number of days allowed between password changes.
#	PASS_WARN_AGE	Number of days warning given before a password expires.
#
PASS_MAX_DAYS	30
PASS_MIN_DAYS	1
PASS_WARN_AGE	30
UID_MIN			 1000
UID_MAX			60000
#SYS_UID_MIN		  101
#SYS_UID_MAX		  999
SUB_UID_MIN		   100000
SUB_UID_MAX		600100000
SUB_UID_COUNT		    65536
GID_MIN			 1000
GID_MAX			60000
#SYS_GID_MIN		  101
#SYS_GID_MAX		  999
SUB_GID_MIN		   100000
SUB_GID_MAX		600100000
SUB_GID_COUNT		    65536
LOGIN_RETRIES		3
LOGIN_TIMEOUT		30
#seconds ^
CHFN_RESTRICT		rwh
ENCRYPT_METHOD BCRYPT
#JUST USE BCRYPT ^
#
DEFAULT_HOME	no
#disallow access to home dir if login fails ^
#
NONEXISTENT	/nonexistent
#keep for debug, flags sysAccounts w/o a valid dir
#
#USERDEL_CMD	/usr/sbin/userdel_local
#purge all chron/print jobs upon <delusr> ^
USERGROUPS_ENAB yes
#purge independent user groups upon <delusr> ^
